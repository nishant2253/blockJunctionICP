# ========================================
# BlockJunction Cross-Chain DEX Aggregator
# Environment Configuration Template
# ========================================

# ==========================================
# ESSENTIAL APIs (Required for Production)
# ==========================================

# CoinMarketCap API - Real-time cryptocurrency prices
# Get your free API key: https://coinmarketcap.com/api/
# Free tier: 10,000 calls/month
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# CoinGecko API - Alternative price data source
# Get your free API key: https://www.coingecko.com/en/api
# Free tier: 50 calls/minute
COINGECKO_API_KEY=your_coingecko_api_key_here

# Moralis API - Multi-chain blockchain data
# Get your free API key: https://moralis.io/
# Free tier: 40,000 requests/month
MORALIS_API_KEY=your_moralis_api_key_here

# ==========================================
# BLOCKCHAIN RPC ENDPOINTS
# ==========================================

# Ethereum Mainnet RPC
# Option 1: Infura (https://infura.io/)
# Option 2: Alchemy (https://www.alchemy.com/)
# Option 3: QuickNode (https://www.quicknode.com/)
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_project_id
# Alternative: ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# Arbitrum RPC
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Alternative: ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your_alchemy_key

# Polygon RPC
POLYGON_RPC_URL=https://polygon-rpc.com
# Alternative: POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_key

# Optimism RPC
OPTIMISM_RPC_URL=https://mainnet.optimism.io
# Alternative: OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/your_alchemy_key

# Solana RPC
# Get your endpoint: https://www.quicknode.com/ or https://www.alchemy.com/solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Alternative: SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/your_alchemy_key

# ==========================================
# DEX-SPECIFIC API KEYS
# ==========================================

# The Graph Protocol - Decentralized indexing for Uniswap and other protocols
# Get your API key: https://thegraph.com/studio/
# Free tier: 100,000 queries/month
UNISWAP_SUBGRAPH_KEY=your_graph_api_key_here
SUSHISWAP_SUBGRAPH_KEY=your_graph_api_key_here

# Uniswap V3 Subgraph Endpoint
UNISWAP_V3_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3

# SushiSwap Subgraph Endpoint
SUSHISWAP_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/sushiswap/exchange

# ==========================================
# OPTIONAL ENHANCED APIS
# ==========================================

# 1inch API - Additional DEX aggregation data
# Get your API key: https://portal.1inch.dev/
# Free tier: 100 requests/second
ONEINCH_API_KEY=your_1inch_api_key_here

# 0x Protocol API - Professional market making
# Get your API key: https://0x.org/docs/api
# Free tier: 100 requests/second
ZEROX_API_KEY=your_0x_api_key_here

# DeFiPulse API - DeFi analytics and TVL data
# Get your API key: https://data-api.defipulse.com/
DEFIPULSE_API_KEY=your_defipulse_api_key_here

# Dune Analytics API - Custom blockchain queries
# Get your API key: https://dune.com/docs/api/
DUNE_API_KEY=your_dune_api_key_here

# ==========================================
# ICP NETWORK CONFIGURATION
# ==========================================

# Network environment (local, testnet, ic)
DFX_NETWORK=local
IC_NETWORK=local

# Local development canister IDs (auto-generated after first deployment)
# Frontend accessible canister IDs (with VITE_ prefix)
VITE_CANISTER_ID_LIQUIDITY_AGGREGATOR=<your_liquidity_aggregator_id_here>
VITE_CANISTER_ID_SWAP_EXECUTOR=<your_canister_swap_executor_id_here>
VITE_CANISTER_ID_BLOCKCHAIN_JUNCTION_BACKEND=<your_blockchain_junction_backend_id_here>
VITE_CANISTER_ID_INTERNET_IDENTITY=<your_internet_identity_id_here>

# Backend only canister IDs (without VITE_ prefix for backend use)
LIQUIDITY_AGGREGATOR_CANISTER_ID=<your_liquidity_aggregator_id_here>
SWAP_EXECUTOR_CANISTER_ID=<your_swap_executor_id_here>
BLOCKCHAIN_JUNCTION_BACKEND_CANISTER_ID=<your_backend_id_here>
BLOCKCHAIN_JUNCTION_FRONTEND_CANISTER_ID=<your_frontend_id_here>

# Mainnet canister IDs (update after mainnet deployment)
# LIQUIDITY_AGGREGATOR_CANISTER_ID_IC=your_mainnet_liquidity_aggregator_id
# SWAP_EXECUTOR_CANISTER_ID_IC=your_mainnet_swap_executor_id
# BLOCKCHAIN_JUNCTION_BACKEND_CANISTER_ID_IC=your_mainnet_backend_id
# BLOCKCHAIN_JUNCTION_FRONTEND_CANISTER_ID_IC=your_mainnet_frontend_id

# ==========================================
# DEVELOPMENT CONFIGURATION
# ==========================================

# Development mode settings
NODE_ENV=development
REACT_APP_ENV=development

# Frontend development server
REACT_APP_PORT=3000
REACT_APP_HOST=localhost

# API rate limiting (requests per minute)
API_RATE_LIMIT=60

# Cache settings (in seconds)
PRICE_CACHE_TTL=300
LIQUIDITY_CACHE_TTL=60
ROUTE_CACHE_TTL=30

# ==========================================
# SECURITY SETTINGS
# ==========================================

# CORS settings for frontend
CORS_ORIGIN=http://localhost:3000,http://localhost:4943

# API request timeout (in milliseconds)
API_TIMEOUT=10000

# Maximum batch size for swap orders
MAX_BATCH_SIZE=50

# Maximum route hops for pathfinding
MAX_ROUTE_HOPS=3

# ==========================================
# MONITORING & ANALYTICS
# ==========================================

# Sentry for error tracking (optional)
# Get your DSN: https://sentry.io/
SENTRY_DSN=your_sentry_dsn_here

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=your_ga_tracking_id_here

# Mixpanel for user analytics (optional)
# Get your token: https://mixpanel.com/
MIXPANEL_TOKEN=your_mixpanel_token_here

# ==========================================
# WEBHOOK ENDPOINTS (Optional)
# ==========================================

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Slack webhook for alerts
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# ==========================================
# ADVANCED CONFIGURATION
# ==========================================

# Gas price settings (in gwei)
DEFAULT_GAS_PRICE=20
MAX_GAS_PRICE=100

# Slippage tolerance (in basis points, 100 = 1%)
DEFAULT_SLIPPAGE_TOLERANCE=100
MAX_SLIPPAGE_TOLERANCE=1000

# Price impact warning threshold (in basis points)
PRICE_IMPACT_WARNING_THRESHOLD=300

# Minimum liquidity threshold for route inclusion
MIN_LIQUIDITY_THRESHOLD=10000

# ==========================================
# TESTING CONFIGURATION
# ==========================================

# Test network settings
TEST_PRIVATE_KEY=your_test_private_key_here
TEST_WALLET_ADDRESS=your_test_wallet_address_here

# Testnet RPC URLs
ETHEREUM_TESTNET_RPC=https://goerli.infura.io/v3/your_infura_project_id
POLYGON_TESTNET_RPC=https://rpc-mumbai.maticvigil.com
ARBITRUM_TESTNET_RPC=https://goerli-rollup.arbitrum.io/rpc

# ==========================================
# INSTRUCTIONS FOR SETUP
# ==========================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all "your_*_here" placeholders with actual API keys
# 3. Start with the ESSENTIAL APIs section for basic functionality
# 4. Add BLOCKCHAIN RPC ENDPOINTS for multi-chain support
# 5. Configure DEX-SPECIFIC APIs for real-time liquidity data
# 6. Optional APIs can be added later for enhanced features

# ==========================================
# API KEY PRIORITY (Start with these)
# ==========================================

# HIGH PRIORITY (Required for basic functionality):
# - COINMARKETCAP_API_KEY or COINGECKO_API_KEY
# - ETHEREUM_RPC_URL (Infura/Alchemy)
# - MORALIS_API_KEY

# MEDIUM PRIORITY (Required for full cross-chain support):
# - ARBITRUM_RPC_URL
# - POLYGON_RPC_URL
# - SOLANA_RPC_URL
# - UNISWAP_SUBGRAPH_KEY

# LOW PRIORITY (Enhanced features):
# - ONEINCH_API_KEY
# - ZEROX_API_KEY
# - DEFIPULSE_API_KEY

# ==========================================
# COST BREAKDOWN (Monthly estimates)
# ==========================================

# Free tier usage (sufficient for development):
# - CoinMarketCap: $0 (10K calls)
# - CoinGecko: $0 (unlimited with rate limits)
# - Moralis: $0 (40K requests)
# - Infura: $0 (100K requests)
# - The Graph: $0 (100K queries)

# Production usage (estimated costs):
# - CoinMarketCap Pro: $29/month (300K calls)
# - Moralis Pro: $49/month (1M requests)
# - Infura Growth: $50/month (1M requests)
# - Alchemy Growth: $49/month (1M requests)

# Total estimated monthly cost for production: $150-200/month
